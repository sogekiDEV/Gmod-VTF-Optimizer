<Window x:Class="ContentOptimizer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ContentOptimizer.App.Services"
        xmlns:vm="clr-namespace:ContentOptimizer.App.ViewModels"
        Title="VTF Optimizer" Width="1240" Height="880" MinWidth="1060" MinHeight="680"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, Nirmala UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <loc:BoolToVisibilityConverter x:Key="BoolVis"/>
        <loc:EqualsConverter x:Key="Eq"/>
    </Window.Resources>

    <Grid Background="{StaticResource BgBrush}"
          FlowDirection="{Binding Source={x:Static loc:Loc.Instance}, Path=Flow}">
        <Grid Margin="24,18,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="2,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="VTF Optimizer" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock Text="{loc:T app_subtitle}" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource PillButton}" Command="{Binding ToggleLanguageMenuCommand}"
                        ToolTip="{loc:T lang_tooltip}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE774;" FontSize="16" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="{Binding CurrentLanguageName}" FontWeight="SemiBold" Margin="10,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70D;" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="440"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer x:Name="LeftPanel" Grid.Column="0" Style="{StaticResource LeftScroll}" IsEnabled="{Binding IsNotApplying}"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,12,0">

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="{loc:T source_title}"/>
                                <Button x:Name="DropZone" Style="{StaticResource DropZoneButton}" Command="{Binding BrowseSourceCommand}"
                                        AllowDrop="True" DragEnter="DropZone_DragEnter" DragOver="DropZone_DragEnter"
                                        DragLeave="DropZone_DragLeave" Drop="DropZone_Drop" Height="112" Margin="0,12,0,0">
                                    <Grid>
                                        <StackPanel HorizontalAlignment="Center"
                                                    Visibility="{Binding HasSource, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8B7;" FontSize="28" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{loc:T source_drop}" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{loc:T source_browse}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        <Grid Visibility="{Binding HasSource, Converter={StaticResource BoolVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8B7;" FontSize="30" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SourceName}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                                                <TextBlock Text="{Binding SourcePath}" ToolTip="{Binding SourcePath}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" FlowDirection="LeftToRight"/>
                                                <TextBlock Text="{Binding SourceSummary}" Foreground="{StaticResource AccentBrush}" FontSize="12.5" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="{loc:T level_title}"/>
                                <ItemsControl ItemsSource="{Binding Presets}" Margin="-4,10,-4,-4">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <RadioButton Style="{StaticResource PresetCard}" GroupName="Preset" Margin="4"
                                                         IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" Margin="0,2,0,10"/>
                                                    <TextBlock Text="{Binding Prediction}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12.5"/>
                                                </StackPanel>
                                            </RadioButton>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="{loc:T settings_title}"/>
                                <CheckBox Style="{StaticResource SwitchBox}" IsChecked="{Binding ConvertFormats}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{loc:T set_dxt}"/>
                                        <TextBlock Text="{loc:T set_dxt_d}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox Style="{StaticResource SwitchBox}" IsChecked="{Binding DetectOpaque}" IsEnabled="{Binding ConvertFormats}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{loc:T set_opaque}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{loc:T set_opaque_d}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox Style="{StaticResource SwitchBox}" IsChecked="{Binding ConvertNormalMaps}" IsEnabled="{Binding ConvertFormats}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{loc:T set_normal}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{loc:T set_normal_d}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox Style="{StaticResource SwitchBox}" IsChecked="{Binding RespectNoLod}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{loc:T set_nolod}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{loc:T set_nolod_d}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </CheckBox>

                                <ToggleButton x:Name="AdvancedToggle" IsChecked="{Binding ShowAdvanced, Mode=TwoWay}" Style="{StaticResource LinkToggle}" Margin="0,18,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{loc:T set_advanced}" FontWeight="SemiBold"/>
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70D;" FontSize="11" Margin="8,2,0,0" VerticalAlignment="Center"
                                                   Visibility="{Binding ShowAdvanced, Converter={StaticResource BoolVis}, ConverterParameter=invert}"/>
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70E;" FontSize="11" Margin="8,2,0,0" VerticalAlignment="Center"
                                                   Visibility="{Binding ShowAdvanced, Converter={StaticResource BoolVis}}"/>
                                    </StackPanel>
                                </ToggleButton>

                                <Grid Margin="0,14,0,0" Visibility="{Binding ShowAdvanced, Converter={StaticResource BoolVis}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="92"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Row="0" VerticalAlignment="Center" Margin="0,0,12,10">
                                        <TextBlock Text="{loc:T adv_cap}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{loc:T adv_cap_d}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource DarkTextBox}" Margin="0,0,0,10" FlowDirection="LeftToRight"
                                             Text="{Binding SelectedCap, UpdateSourceTrigger=LostFocus}"/>

                                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,12,10">
                                        <TextBlock Text="{loc:T adv_trigger}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{loc:T adv_trigger_d}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource DarkTextBox}" Margin="0,0,0,10" FlowDirection="LeftToRight"
                                             Text="{Binding TriggerSide, UpdateSourceTrigger=LostFocus}"/>

                                    <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="0,0,12,10">
                                        <TextBlock Text="{loc:T adv_minside}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{loc:T adv_minside_d}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource DarkTextBox}" Margin="0,0,0,10" FlowDirection="LeftToRight"
                                             Text="{Binding MinConvertSide, UpdateSourceTrigger=LostFocus}"/>

                                    <StackPanel Grid.Row="3" VerticalAlignment="Center" Margin="0,0,12,10">
                                        <TextBlock Text="{loc:T adv_psnr}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{loc:T adv_psnr_d}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource DarkTextBox}" Margin="0,0,0,10" FlowDirection="LeftToRight"
                                             Text="{Binding QualityFloorDb, UpdateSourceTrigger=LostFocus}"/>

                                    <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="{loc:T adv_excludes}" Margin="0,4,0,6"/>
                                    <TextBox Grid.Row="5" Grid.ColumnSpan="2" Style="{StaticResource DarkTextBox}" Height="96" AcceptsReturn="True" FlowDirection="LeftToRight"
                                             VerticalContentAlignment="Top" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                             Text="{Binding ExcludesText, UpdateSourceTrigger=LostFocus}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="{loc:T out_title}"/>
                                <RadioButton Style="{StaticResource OptionRadio}" GroupName="Mode" Margin="0,14,0,0"
                                             IsChecked="{Binding Mode, Mode=TwoWay, Converter={StaticResource Eq}, ConverterParameter={x:Static vm:OutputMode.Mirror}}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:T out_mirror}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{loc:T out_mirror_d}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource OptionRadio}" GroupName="Mode" Margin="0,12,0,0"
                                             IsChecked="{Binding Mode, Mode=TwoWay, Converter={StaticResource Eq}, ConverterParameter={x:Static vm:OutputMode.InPlace}}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:T out_inplace}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{loc:T out_inplace_d}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </RadioButton>

                                <TextBlock Text="{Binding TargetLabel}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" Margin="0,18,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}" Padding="10,9" FlowDirection="LeftToRight"/>
                                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE8B7;" Margin="8,0,0,0" Command="{Binding BrowseTargetCommand}" Height="Auto"/>
                                </Grid>
                                <TextBlock Text="{Binding TargetHint}" Foreground="{StaticResource DangerBrush}" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <CheckBox Style="{StaticResource SwitchBox}" IsChecked="{Binding CopyEverything}" Margin="0,16,0,0"
                                          Visibility="{Binding IsMirror, Converter={StaticResource BoolVis}}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:T out_copyrest}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{loc:T out_copyrest_d}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="24,20" Margin="0,0,0,14">
                        <Grid>
                            <StackPanel Visibility="{Binding HasReport, Converter={StaticResource BoolVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="{Binding SummaryTitle}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding SavedText}" FontSize="42" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Border Background="{StaticResource AccentDimBrush}" CornerRadius="8" Padding="10,4" Margin="14,6,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SavedPercentText}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="15"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <StackPanel Margin="30,0,0,0">
                                            <TextBlock Text="{loc:T sum_before}" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Text="{Binding BeforeText}" FontSize="19" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <StackPanel Margin="30,0,0,0">
                                            <TextBlock Text="{loc:T sum_after}" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Text="{Binding AfterText}" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <StackPanel Margin="30,0,0,0">
                                            <TextBlock Text="{Binding CountLabel}" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Margin="0,3,0,0" FontSize="19" FontWeight="SemiBold" FlowDirection="LeftToRight" HorizontalAlignment="Left">
                                                <Run Text="{Binding OptimizedCount, Mode=OneWay}"/><Run Text=" / " Foreground="{StaticResource MutedBrush}"/><Run Text="{Binding TotalCount, Mode=OneWay}" Foreground="{StaticResource MutedBrush}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <ProgressBar Style="{StaticResource SizeBar}" Minimum="0" Maximum="1" Value="{Binding AfterFraction, Mode=OneWay}" Height="10" Margin="0,18,0,8"/>
                                <Grid>
                                    <TextBlock Text="{loc:T sum_bar_left}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" HorizontalAlignment="Left"/>
                                    <TextBlock Text="{Binding BarRightText}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" HorizontalAlignment="Right"/>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Chips}" Margin="0,14,0,-8">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="12,7" Margin="0,0,8,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Text}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Height="132" VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding HasReport, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE9D9;" FontSize="30" Foreground="{StaticResource LineStrongBrush}" HorizontalAlignment="Center" Margin="0,22,0,10"/>
                                <TextBlock Text="{loc:T sum_empty}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20,16,14,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Margin="0,0,6,0">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <RadioButton Style="{StaticResource TabRadio}" GroupName="Tab" Content="{Binding FilesTabLabel}"
                                                     IsChecked="{Binding Tab, Mode=TwoWay, Converter={StaticResource Eq}, ConverterParameter={x:Static vm:ResultTab.Files}}"/>
                                        <RadioButton Style="{StaticResource TabRadio}" GroupName="Tab" Content="{loc:T tab_log}"
                                                     IsChecked="{Binding Tab, Mode=TwoWay, Converter={StaticResource Eq}, ConverterParameter={x:Static vm:ResultTab.Log}}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,0,0"
                                                Visibility="{Binding IsFilesTab, Converter={StaticResource BoolVis}}">
                                        <RadioButton Style="{StaticResource ChipRadio}" GroupName="Filter" Content="{loc:T filter_all}"
                                                     IsChecked="{Binding Filter, Mode=TwoWay, Converter={StaticResource Eq}, ConverterParameter={x:Static vm:ResultFilter.All}}"/>
                                        <RadioButton Style="{StaticResource ChipRadio}" GroupName="Filter" Content="{loc:T filter_opt}"
                                                     IsChecked="{Binding Filter, Mode=TwoWay, Converter={StaticResource Eq}, ConverterParameter={x:Static vm:ResultFilter.Optimized}}"/>
                                        <RadioButton Style="{StaticResource ChipRadio}" GroupName="Filter" Content="{loc:T filter_skip}"
                                                     IsChecked="{Binding Filter, Mode=TwoWay, Converter={StaticResource Eq}, ConverterParameter={x:Static vm:ResultFilter.Skipped}}"/>
                                        <RadioButton Style="{StaticResource ChipRadio}" GroupName="Filter" Content="{loc:T filter_fail}"
                                                     IsChecked="{Binding Filter, Mode=TwoWay, Converter={StaticResource Eq}, ConverterParameter={x:Static vm:ResultFilter.Failed}}"/>
                                        <Button Style="{StaticResource LinkButton}" Content="{loc:T export_csv}" Command="{Binding ExportCsvCommand}" FontSize="12" Margin="14,5,6,0"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource LinkButton}" Content="{loc:T clear}" Command="{Binding ClearLogCommand}" FontSize="12"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,6,0"
                                            Visibility="{Binding IsLogTab, Converter={StaticResource BoolVis}}"/>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                <Grid Visibility="{Binding IsFilesTab, Converter={StaticResource BoolVis}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Margin="10,2,16,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="190"/>
                                            <ColumnDefinition Width="210"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="1" Text="{loc:T col_file}" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Grid.Column="2" Text="{loc:T col_change}" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Grid.Column="3" Text="{loc:T col_size}" Style="{StaticResource CardTitle}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <ListBox Grid.Row="1" Style="{StaticResource RowList}" ItemsSource="{Binding Rows}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:FileRowViewModel}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="22"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="190"/>
                                                        <ColumnDefinition Width="210"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Top" Margin="0,6,0,0" HorizontalAlignment="Left"/>
                                                    <StackPanel Grid.Column="1" Margin="0,0,14,0" FlowDirection="LeftToRight">
                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                                        <TextBlock Text="{Binding Directory}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Directory}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="{Binding ChangeTop}"/>
                                                        <TextBlock Text="{Binding ChangeBottom}" Foreground="{Binding ChangeBottomBrush}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="3">
                                                        <TextBlock Text="{Binding SizeTop}" Foreground="{Binding SizeTopBrush}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                        <TextBlock Text="{Binding SizeBottom}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" HorizontalAlignment="Right"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Grid.Row="1" Text="{loc:T list_empty}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <ListBox x:Name="LogList" Style="{StaticResource RowList}" ItemsSource="{Binding Log}"
                                         Visibility="{Binding IsLogTab, Converter={StaticResource BoolVis}}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:LogEntry}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Time}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,1,14,0" FlowDirection="LeftToRight"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Message}" Foreground="{Binding Brush}" TextWrapping="Wrap"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="20,14" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,28,0">
                        <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"/>
                        <ProgressBar Style="{StaticResource SlimProgress}" Minimum="0" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}" Height="6" Margin="0,9,0,0"
                                     Visibility="{Binding ShowProgress, Converter={StaticResource BoolVis}, ConverterParameter=hidden}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource GhostButton}" Content="{loc:T btn_open}" Command="{Binding OpenOutputCommand}" Margin="0,0,10,0"
                                Visibility="{Binding CanOpenOutput, Converter={StaticResource BoolVis}}"/>
                        <Button Style="{StaticResource GhostButton}" Content="{loc:T btn_cancel}" Command="{Binding CancelCommand}" Margin="0,0,10,0"
                                Visibility="{Binding IsApplying, Converter={StaticResource BoolVis}}"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="{Binding PrimaryText}" Command="{Binding OptimizeCommand}" MinWidth="150"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Visibility="{Binding ShowLanguageMenu, Converter={StaticResource BoolVis}}">
            <Button Style="{StaticResource ScrimButton}" Command="{Binding ToggleLanguageMenuCommand}"/>
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="24,68,24,0" Width="230" Padding="6"
                    Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1" CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.5" Color="Black"/>
                </Border.Effect>
                <ItemsControl ItemsSource="{Binding Languages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource LangItem}" CommandParameter="{Binding Code}"
                                    Command="{Binding DataContext.SelectLanguageCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding NativeName}" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" FontFamily="{StaticResource IconFont}" Text="&#xE73E;" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"
                                               Visibility="{Binding IsSelected, Converter={StaticResource BoolVis}}"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Grid>
    </Grid>
</Window>
